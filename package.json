{
  "name": "tyda",
  "version": "0.1.0",
  "description": "Swiggy MCP TUI — order Food, Instamart, and Dineout from the terminal.",
  "type": "module",
  "bin": {
    "tyda": "dist/tui/cli.js"
  },
  "main": "dist/tui/cli.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "mock": "tsx src/server/index.ts",
    "tui": "tsx src/tui/cli.ts",
    "zepto": "tsx src/zepto/cli.ts",
    "zepto:login": "tsx src/zepto/cli.ts login",
    "zepto:status": "tsx src/zepto/cli.ts status",
    "zepto:refresh": "tsx src/zepto/cli.ts refresh",
    "zepto:recon": "tsx src/zepto/recon.ts",
    "zepto:search": "tsx src/zepto/cli.ts search",
    "zepto:cart-demo": "tsx src/zepto/cli.ts cart-demo",
    "zepto:cart-clear": "tsx src/zepto/cli.ts cart-clear",
    "zepto:tui": "tsx src/zepto/tui.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,json}\" \"tests/**/*.{ts,tsx}\""
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "fastify": "^5.2.0",
    "ink": "^5.1.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "jimp": "^1.6.1",
    "jose": "^5.9.0",
    "openai": "^4.77.0",
    "playwright": "^1.60.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "react": "^18.3.1",
    "yaml": "^2.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "ink-testing-library": "^4.0.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
